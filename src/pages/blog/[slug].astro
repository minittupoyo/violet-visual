---
import { render } from "astro:content";
import { getPosts } from "@/lib/posts";
import Layout from "@/layouts/Layout.astro";
import ToC from "@/components/ToC.astro";
import ImageZoom from "@/components/ImageZoom.astro";

export async function getStaticPaths() {
    const posts = await getPosts();
    return posts.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Layout
    title={entry.data.title}
    description={entry.data.description}
    ogImage={`/og/${entry.id}.png`}
    ogType="article"
    publishedTime={entry.data.date}
>
    <div class="mx-auto max-w-5xl px-6">
        <article>
            <header class="py-6 pb-8 space-y-2 border-b border-base-300">
                <a href="/blog" class="link link-primary hover:underline">
                    &larr; 一覧へ戻る
                </a>
                <p class="mt-6">
                    <span class="text-sm font-mono text-primary">
                        {entry.data.date.toLocaleDateString("ja-JP")}
                    </span>
                </p>
                <h1 class="text-2xl md:text-3xl font-bold">
                    {entry.data.title}
                </h1>
                <p class="text-lg text-base-content/80">
                    {entry.data.description}
                </p>
            </header>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 w-full py-8">
                <div
                    class="order-1 md:col-span-3 prose prose-theme prose-img:rounded-lg max-w-none [&_iframe]:w-full [&_iframe]:max-w-full [&_iframe]:aspect-video [&_iframe]:rounded-lg"
                >
                    <Content />
                </div>
                <ImageZoom />
                <div class="order-2 hidden md:block">
                    <div class="sticky top-24">
                        <ToC headings={headings} />
                    </div>
                </div>
            </div>
            <footer
                class="border-t border-base-300 py-6 text-sm leading-7 text-base-content/60"
            >
                この記事は特記がない限り
                <a
                    href="https://creativecommons.org/licenses/by/4.0/deed.ja"
                    target="_blank"
                    rel="license noreferrer"
                    class="link link-primary"
                >CC BY 4.0</a>
                で利用できます。引用・埋め込み・第三者の著作物は除きます。
            </footer>
        </article>
    </div>
</Layout>
