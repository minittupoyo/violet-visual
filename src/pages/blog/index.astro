---
import Layout from "@/layouts/Layout.astro";
import { getPosts } from "@/lib/posts";

const posts = await getPosts();
---

<Layout>
    <div class="mx-auto max-w-5xl px-6">
        <section class="py-8 space-y-4">
            <h2 class="text-2xl md:text-3xl font-bold">Posts</h2>
            <p class="text-lg text-zinc-600 tracking-tight">
                ブログです。ちょこちょこ書いてます。
            </p>
        </section>
        <section class="pb-8">
            <div class="grid grid-cols-1 w-full divide-y divide-zinc-200">
                {
                    posts.map((post) => (
                        <a
                            href={`/blog/${post.id}`}
                            class="flex flex-row py-4 group"
                        >
                            <div class="mr-auto flex flex-col">
                                <p class="text-blue-600 text-sm font-mono">
                                    {post.data.date.toLocaleDateString("ja-JP")}
                                </p>
                                <p class="text-2xl font-bold mt-2">
                                    {post.data.title}
                                </p>
                                <p class="text-md text-zinc-600 line-clamp-2">
                                    {post.data.description}
                                </p>
                            </div>
                            <span class="self-center opacity-0 transition group-hover:translate-x-1 group-hover:opacity-100">
                                &rarr;
                            </span>
                        </a>
                    ))
                }
            </div>
        </section>
    </div>
</Layout>
