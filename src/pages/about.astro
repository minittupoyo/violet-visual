---
import Layout from "@/layouts/Layout.astro";

const likes = [
    {
        label: "Music",
        value: "*Luna / Aqu3ra / ナナツカゼ",
    },
    {
        label: "Anime / Manga",
        value: "百合とか。",
    },
    {
        label: "Games",
        value: "美少女ゲーム / プロセカ",
    },
    {
        label: "Computer",
        value: "Linux / 自作PC / Web / AI",
    },
];

const links = [
    {
        label: "GitHub",
        value: "minittupoyo",
        href: "https://github.com/minittupoyo",
    },
    {
        label: "ListenBrainz",
        value: "minittupoyo",
        href: "https://listenbrainz.org/user/minittupoyo/",
    },
];
---

<Layout
    title="About"
    description="みにっつと、このブログについて。Web、Linux、自作PC、AI、音楽、ゲームなど、好きなものや書いていることをまとめています。"
>
    <div class="site-container page-layout">
        <header class="page-intro">
            <p class="page-eyebrow">About</p>
            <h1 class="page-title">みにっつ / minittupoyo</h1>
            <p class="page-lead">
                18歳のニートです。ちょっとだけプログラミングができます。
                Webサイトやデスクトップアプリを作ったり、Linuxをいじったり、
                自作PCを触ったりしています。
            </p>
        </header>

        <section
            class="page-section page-section--divided"
        >
            <h2 class="section-label">Me</h2>
            <div class="section-copy">
                <p>
                    AstroやVue、Tauriあたりを触ることが多いです。
                    最近はAIにコードを書かせることも多め。
                </p>
                <p>
                    プログラミング以外だと、音楽を聴いたり、アニメを見たり、
                    美少女ゲームをやったりしています。
                </p>
            </div>
        </section>

        <section
            class="page-section page-section--divided"
        >
            <h2 class="section-label">This blog</h2>
            <div class="section-copy">
                <p class="section-heading">
                    技術ブログというより、個人ブログ。
                </p>
                <p>
                    自分が試したこと、ハマったこと、あとで忘れそうな設定や、
                    その時々で考えたことを残しています。
                </p>
                <p>
                    ちゃんとした解説記事を書くこともあれば、
                    「これで動いた」くらいの記事もあります。
                    LinuxやWeb、AI、自作PCの話が多めですが、
                    音楽やゲーム、買ったもの、その時に考えたことも書きます。
                </p>
            </div>
        </section>

        <section
            class="page-section page-section--divided"
        >
            <h2 class="section-label">Likes</h2>
            <dl class="max-w-2xl divide-y divide-base-300">
                {
                    likes.map((item) => (
                        <div class="grid gap-1 py-4 first:pt-0 last:pb-0 sm:grid-cols-[9rem_minmax(0,1fr)] sm:gap-6">
                            <dt class="font-medium text-base-content">
                                {item.label}
                            </dt>
                            <dd class="text-base-content/80">{item.value}</dd>
                        </div>
                    ))
                }
            </dl>
        </section>

        <section
            class="page-section"
        >
            <h2 class="section-label">Links</h2>
            <ul class="max-w-2xl divide-y divide-base-300">
                {
                    links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                target="_blank"
                                rel="noreferrer"
                                class="group flex items-center gap-2 py-4 first:pt-0 last:pb-0"
                            >
                                <span class="font-medium text-base-content">
                                    {link.label}
                                </span>
                                <span class="font-mono text-sm text-base-content/60">
                                    {link.value}
                                </span>
                                <span class="ml-auto text-primary transition group-hover:translate-x-0.5">
                                    &rarr;
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </section>
    </div>
</Layout>
