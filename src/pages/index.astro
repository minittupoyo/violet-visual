---
import ThemeSelect from "@/components/ThemeSelect.astro";
import Layout from "@/layouts/Layout.astro";
import { getPosts } from "@/lib/posts";
import ListenBrainzRecent from "@/components/ListenBrainzRecent.astro";
import PostList from "@/components/PostList.astro";

const posts = await getPosts();
---

<Layout hideHeader={true}>
    <div class="site-container page-layout">
        <section class="page-intro">
            <p class="page-eyebrow">minittupoyo</p>
            <h1 class="page-title">みにっつ</h1>
            <nav class="site-nav">
                <a href="/" class="btn btn-ghost btn-sm">Home</a>
                <a href="/about" class="btn btn-ghost btn-sm">About</a>
                <a href="/blog" class="btn btn-ghost btn-sm">Posts</a>
                <ThemeSelect />
            </nav>
        </section>
        <section class="page-section page-section--divided">
            <div class="section-label">About</div>
            <div class="section-copy">
                <h2 class="section-heading">ちょっとだけプログラミングができます。</h2>
                <p>
                18歳のニートです。<br
                />Tauriでデスクトップアプリ作ったり、JSでサイト作ったり。
                </p>
                <a href="/about" class="text-action">
                    もっと詳しく <span class="text-action__arrow" aria-hidden="true">&rarr;</span>
                </a>
            </div>
        </section>
        <section class="page-section page-section--divided">
            <div class="section-label">Posts</div>
            <div class="section-copy">
                <h2 class="section-heading">ブログです。ちょこちょこ書いてます。</h2>
                <PostList posts={posts.slice(0, 6)} />
                <a href="/blog" class="text-action">
                    全部見る <span class="text-action__arrow" aria-hidden="true">&rarr;</span>
                </a>
            </div>
        </section>
        <ListenBrainzRecent username="minittupoyo" count={5} />
    </div>
</Layout>
