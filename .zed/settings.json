{
    "tab_size": 4,
    "format_on_save": "on",
    "languages": {
        "Astro": {
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            }
        },
        "CSS": {
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            },
            "language_servers": [
                "tailwindcss-intellisense-css",
                "!vscode-css-language-server"
            ]
        },
        "TypeScript": {
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": ["--stdin-filepath", "{buffer_path}"]
                }
            }
        }
    }
}
