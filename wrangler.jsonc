{
    "$schema": "https://unpkg.com/wrangler/config-schema.json",
    "name": "violet-visual",
    "main": "./worker/index.ts",
    "compatibility_date": "2026-09-07",
    "assets": {
        "directory": "./dist/",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"],
        "html_handling": "auto-trailing-slash",
    },
}
